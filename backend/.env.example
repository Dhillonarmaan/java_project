# KeyBridge backend environment variables.
# Copy to backend/.env (git-ignored) and fill in real values:
#   cp .env.example .env
# Spring Boot loads backend/.env automatically (spring.config.import in
# application.yml) when started from the backend/ directory. Real
# environment variables take precedence over values in this file.

# MySQL username. Optional, defaults to "root".
DB_USERNAME=root

# MySQL password. Required.
DB_PASSWORD=change-me

# HMAC-SHA256 key for signing JWTs. Required, at least 32 characters.
# Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-output-of-openssl-rand-hex-32

# Password protecting the PKCS#12 keystores in KEYSTORE_DIR. Required.
# Changing it makes existing .p12 files unreadable: delete keystore-data/
# (and reset the database) so they are regenerated.
KS_PASSWORD=change-me

# Directory for .p12 keystores. Optional, defaults to ./keystore-data.
# KEYSTORE_DIR=./keystore-data
